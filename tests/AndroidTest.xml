<configuration description="Runs Contacts Provider Tests.">
    <target_preparer class="com.android.tradefed.targetprep.suite.SuiteApkInstaller">
        <option name="test-file-name" value="ContactsProviderTests.apk" />
    </target_preparer>
    <target_preparer class="com.android.tradefed.targetprep.FeatureFlagTargetPreparer" />

    <!-- GrapheneOS: allow DexMaker to load Mockito code from the provider's storage. -->
    <target_preparer class="com.android.tradefed.targetprep.RunCommandTargetPreparer">
        <option name="throw-if-cmd-fail" value="true" />
        <option name="test-user-token" value="%TEST_USER%" />
        <option name="run-command"
                value="su root setprop persist.sys.allow_weakening_system_app_sepolicy true" />
        <option name="run-command"
                value="pm edit-gos-package-state com.android.providers.contacts %TEST_USER% add-flag RESTRICT_STORAGE_DYN_CODE_LOADING_NON_DEFAULT clear-flag RESTRICT_STORAGE_DYN_CODE_LOADING set-kill-uid-after-apply true" />
        <option name="teardown-command"
                value="pm edit-gos-package-state com.android.providers.contacts %TEST_USER% clear-flag RESTRICT_STORAGE_DYN_CODE_LOADING_NON_DEFAULT clear-flag RESTRICT_STORAGE_DYN_CODE_LOADING set-kill-uid-after-apply true" />
        <option name="teardown-command"
                value="su root setprop persist.sys.allow_weakening_system_app_sepolicy false" />
    </target_preparer>

    <option name="test-suite-tag" value="apct" />
    <option name="test-tag" value="ContactsProviderTests" />
    <test class="com.android.tradefed.testtype.AndroidJUnitTest" >
        <option name="package" value="com.android.providers.contacts.tests" />
        <option name="hidden-api-checks" value="false"/>
    </test>
</configuration>
